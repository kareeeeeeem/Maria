rules_version = '2';
service cloud.firestore { match/databases/{database}/documents{
  // 💡 دالة مساعدة للتحقق مما إذا كان المستخدم الحالي مسؤولاً
  function isAdmin() {return request.auth != null &&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;}

  // =====================================================================
  // 1. قواعد غرف التدريب المشتركة (ROOM) والمحادثات الفرعية
  // =====================================================================
  match /artifacts/{appId}/public/data/room/{roomId} {

    // 🔥 قاعدة القراءة: السماح للمستخدمين الموثقين فقط برؤية الغرف.
    allow read: if request.auth != null;

    // قاعدة الإنشاء
    allow create: if request.auth != null &&
                   request.resource.data.creatorId == request.auth.uid;

    // قاعدة التحديث المبسطة
    allow update: if request.auth != null && (
      // السماح بالانضمام للغرفة
      request.auth.uid in request.resource.data.participantUids ||
      // السماح للمنشئ بتعديل البيانات
      resource.data.creatorId == request.auth.uid
    );

    // قاعدة الحذف: للمسؤول أو المنشئ فقط.
    allow delete: if isAdmin() ||
                  (request.auth != null && resource.data.creatorId == request.auth.uid);

    // =====================================================================
    // قواعد رسائل الدردشة (messages subcollection)
    // =====================================================================
    match /messages/{messageId} {

      // 🔥 التعديل: أي مستخدم مسجل يقدر يقرأ الرسائل
      allow read: if request.auth != null;

      // الكتابة تبقى للمشاركين فقط
      allow create: if request.auth != null &&
          // الشرط الأول: يجب أن يكون المستخدم مشاركاً في الغرفة
          request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/room/$(roomId)).data.participantUids &&
          // الشرط الثاني: يجب أن يكون المرسل هو المستخدم الحالي
          request.resource.data.senderId == request.auth.uid;

      allow update, delete: if isAdmin();
    }
  }

  // =====================================================================
  // 3. قواعد البيانات العامة المتبقية (المتجر والاشتراكات)
  // =====================================================================
  match /artifacts/{appId}/public/data/{collection}/{document} {
    // السماح بالقراءة للجميع (إذا لم تكن المجموعة 'room').
    allow read: if collection != 'room';
    // السماح بالكتابة فقط للمسؤولين.
    allow write: if isAdmin();
  }

  // =====================================================================
  // 4. قواعد البيانات الخاصة بالمستخدمين
  // =====================================================================

  // أ. بيانات الحساب العام للمستخدمين (/users/{userId})
  match /users/{userId} {
    // القراءة متاحة للمستخدم نفسه أو للمسؤول.
    allow read: if request.auth != null;
    // الكتابة متاحة للمستخدم نفسه أو للمسؤول.
    allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
  }

  // ب. مجموعة المسؤولين (/admins/{document})
  match /admins/{document} {
    allow read: if isAdmin();
    allow write: if false; // الكتابة مغلقة.
  }

  // ت. الإشعارات الخاصة بالمستخدم (/notifications/{userId}/user_notifications/{document})
  match /notifications/{userId}/user_notifications/{document} {
    // القراءة متاحة للمستخدم نفسه فقط.
    allow read: if request.auth != null && request.auth.uid == userId;
    // الكتابة متاحة للمستخدم نفسه أو للمسؤول (لإرسال الإشعارات).
    allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
  }

  // 💡 الجديد: مجموعة الإشعارات الجماعية (public_notifications)
  match /public_notifications/{document} {
    // السماح بالكتابة (إنشاء/تحديث/حذف) فقط للمسؤولين.
    allow write: if isAdmin();
    // منع القراءة نهائياً لعامة المستخدمين
    allow read: if false; 
  }

  // =====================================================================
  // 5. القاعدة الافتراضية
  // =====================================================================
  // منع الوصول لأي مسار غير مغطى صراحةً.
  match /{document=**} {
    allow read, write: if false;
  }
}
}